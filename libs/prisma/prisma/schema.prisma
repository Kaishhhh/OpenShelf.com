generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SELLER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  DRAFT
  DELETED
}

enum ShopStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String   @unique
  password      String?
  avatar        String?
  emailVerified Boolean  @default(false)
  role          Role     @default(USER)
  following     String[]
  fcmTokens     String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reviews       Review[]

}

model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Seller {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String   @unique
  password      String
  phoneNumber   String
  country       String
  stripeId      String?
  // Mirrors of the Connect account's charges_enabled / payouts_enabled, kept in
  // sync by the account.updated webhook. Independent of Shop.status: an
  // approved shop can have neither, and a pending one can have both.
  stripeChargesEnabled Boolean @default(false)
  stripePayoutsEnabled Boolean @default(false)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop          Shop?

  // The webhook finds a seller by account id. Not @unique: Prisma's Mongo
  // unique index is not sparse, so every seller without a stripeId would
  // collide on null. One account per seller is enforced in seller-service.
  @@index([stripeId])
}

model Shop {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  bio          String?
  category     String
  avatar       String?
  coverBanner  String?
  address      String
  openingHours String?
  website      String?
  socialLinks  Json?
  ratings      Float     @default(0)
  status       ShopStatus @default(PENDING)
  // Optional detail on a REJECTED shop; never the signal that a rejection
  // happened — that is `status` alone.
  rejectionReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sellerId     String    @unique @db.ObjectId
  seller       Seller    @relation(fields: [sellerId], references: [id])

  products     Product[]
  reviews      Review[]
}

model Product {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String        @unique
  description String
  category    String
  subCategory String?
  tags        String[]
  price       Float
  salePrice   Float?
  stock       Int           @default(0)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  shopId      String        @db.ObjectId
  shop        Shop          @relation(fields: [shopId], references: [id])

  images      Image[]
  reviews     Review[]

  @@index([shopId])
  @@index([category, status])
  // The storefront's default query: every ACTIVE product, newest first. The
  // compound index above only helps when a category is also supplied.
  @@index([status, createdAt])
}

model Image {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fileId    String
  url       String

  productId String?  @db.ObjectId
  product   Product? @relation(fields: [productId], references: [id])

  // Every image query filters on this, and the public list reads images for a
  // whole page of products at once.
  @@index([productId])
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Float
  comment   String?
  createdAt DateTime @default(now())

  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])

  productId String?  @db.ObjectId
  product   Product? @relation(fields: [productId], references: [id])

  shopId    String?  @db.ObjectId
  shop      Shop?    @relation(fields: [shopId], references: [id])

  @@index([productId])
  @@index([shopId])
}