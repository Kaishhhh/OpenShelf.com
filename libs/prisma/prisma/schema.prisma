generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SELLER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  DRAFT
  DELETED
}

enum ShopStatus {
  PENDING
  APPROVED
  REJECTED
}

// A Payment is SUCCEEDED once and only once — the webhook's claim on that
// transition is what makes a replayed delivery a no-op. FAILED is not final:
// the buyer can retry another card against the same PaymentIntent.
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TransferStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String   @unique
  password      String?
  avatar        String?
  emailVerified Boolean  @default(false)
  role          Role     @default(USER)
  following     String[]
  fcmTokens     String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reviews       Review[]
  payments      Payment[]
  orders        Order[]

}

model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Seller {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String   @unique
  password      String
  phoneNumber   String
  country       String
  stripeId      String?
  // Mirrors of the Connect account's charges_enabled / payouts_enabled, kept in
  // sync by the account.updated webhook. Independent of Shop.status: an
  // approved shop can have neither, and a pending one can have both.
  stripeChargesEnabled Boolean @default(false)
  stripePayoutsEnabled Boolean @default(false)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop          Shop?

  // The webhook finds a seller by account id. Not @unique: Prisma's Mongo
  // unique index is not sparse, so every seller without a stripeId would
  // collide on null. One account per seller is enforced in seller-service.
  @@index([stripeId])
}

model Shop {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  bio          String?
  category     String
  avatar       String?
  coverBanner  String?
  address      String
  openingHours String?
  website      String?
  socialLinks  Json?
  ratings      Float     @default(0)
  status       ShopStatus @default(PENDING)
  // Optional detail on a REJECTED shop; never the signal that a rejection
  // happened — that is `status` alone.
  rejectionReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sellerId     String    @unique @db.ObjectId
  seller       Seller    @relation(fields: [sellerId], references: [id])

  products     Product[]
  reviews      Review[]
  orders       Order[]
}

model Product {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String        @unique
  description String
  category    String
  subCategory String?
  tags        String[]
  price       Float
  salePrice   Float?
  stock       Int           @default(0)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  shopId      String        @db.ObjectId
  shop        Shop          @relation(fields: [shopId], references: [id])

  images      Image[]
  reviews     Review[]

  @@index([shopId])
  @@index([category, status])
  // The storefront's default query: every ACTIVE product, newest first. The
  // compound index above only helps when a category is also supplied.
  @@index([status, createdAt])
}

model Image {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fileId    String
  url       String

  productId String?  @db.ObjectId
  product   Product? @relation(fields: [productId], references: [id])

  // Every image query filters on this, and the public list reads images for a
  // whole page of products at once.
  @@index([productId])
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Float
  comment   String?
  createdAt DateTime @default(now())

  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])

  productId String?  @db.ObjectId
  product   Product? @relation(fields: [productId], references: [id])

  shopId    String?  @db.ObjectId
  shop      Shop?    @relation(fields: [shopId], references: [id])

  @@index([productId])
  @@index([shopId])
}

// ---------------------------------------------------------------------------
// Checkout. Every money field below is an Int in minor units (cents), matching
// Stripe. Product.price is a float in dollars and is converted exactly once, at
// checkout, so the splits here always sum without float drift.
// ---------------------------------------------------------------------------

// One line of the cart as it was priced when checkout started.
//
// The webhook builds orders from this, never from the live cart: the buyer can
// change the cart while paying, and the orders must match what was charged.
type PaymentLine {
  productId String @db.ObjectId
  shopId    String @db.ObjectId
  title     String
  price     Int
  quantity  Int
}

model Payment {
  id                    String        @id @default(auto()) @map("_id") @db.ObjectId
  stripePaymentIntentId String        @unique
  amount                Int
  currency              String
  status                PaymentStatus @default(PENDING)
  lines                 PaymentLine[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  userId                String        @db.ObjectId
  user                  User          @relation(fields: [userId], references: [id])

  orders                Order[]

  @@index([userId])
}

// One per shop per Payment. The unit a seller fulfils and gets paid for.
model Order {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  status           OrderStatus    @default(PENDING)
  subtotal         Int
  // platformFee + sellerAmount == subtotal, always — sellerAmount is derived
  // by subtraction, never rounded separately.
  platformFee      Int
  sellerAmount     Int
  stripeTransferId String?
  transferStatus   TransferStatus @default(PENDING)
  // Set when any item could not be decremented at payment confirmation: the
  // buyer paid for stock that was no longer there. Needs a human.
  stockShortfall   Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  paymentId        String         @db.ObjectId
  payment          Payment        @relation(fields: [paymentId], references: [id])

  shopId           String         @db.ObjectId
  shop             Shop           @relation(fields: [shopId], references: [id])

  userId           String         @db.ObjectId
  user             User           @relation(fields: [userId], references: [id])

  items            OrderItem[]

  // The buyer's history, newest first.
  @@index([userId, createdAt])
  @@index([shopId])
  @@index([paymentId])
}

// Denormalised on purpose. An order is a historical record: a seller editing or
// deleting the product must not change it, so productId is a plain id with no
// relation and title/price are copied in.
model OrderItem {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  productId      String  @db.ObjectId
  title          String
  price          Int
  quantity       Int
  lineTotal      Int
  stockShortfall Boolean @default(false)

  orderId        String  @db.ObjectId
  order          Order   @relation(fields: [orderId], references: [id])

  @@index([orderId])
}
