@base = http://localhost:8080/auth
@seller = http://localhost:8080/seller
@admin = http://localhost:8080/admin

### Register
POST {{base}}/register
Content-Type: application/json

{
  "name": "Kai",
  "email": "kai4@test.com",
  "password": "password123"
}

### Verify OTP - paste the code from your terminal
POST {{base}}/verify-otp
Content-Type: application/json

{
  "email": "kai4@test.com",
  "otp": "914196"
}

### Login
POST {{base}}/login
Content-Type: application/json

{
  "email": "kai4@test.com",
  "password": "password123"
}

### Login - wrong password
POST {{base}}/login
Content-Type: application/json

{
  "email": "kai@test.com",
  "password": "wrongpassword"
}

### Login - nonexistent email
POST {{base}}/login
Content-Type: application/json

{
  "email": "nobody@test.com",
  "password": "password123"
}

### Register - bad input, should 400
POST {{base}}/register
Content-Type: application/json

{
  "name": "",
  "email": "notanemail",
  "password": "short"
}

### Health
GET http://localhost:8080/health

### Seller register
POST {{seller}}/register
Content-Type: application/json

{
  "name": "Kai Shop",
  "email": "seller1@test.com",
  "password": "password123",
  "phoneNumber": "+6582031911",
  "country": "SG"
}

### Seller verify
POST {{seller}}/verify-otp
Content-Type: application/json

{
  "email": "seller1@test.com",
  "otp": "123456"
}

### Seller login
POST {{seller}}/login
Content-Type: application/json

{
  "email": "seller1@test.com",
  "password": "password123"
}

### Seller me
GET {{seller}}/me

### Admin login
POST {{admin}}/login
Content-Type: application/json

{
  "email": "admin@openshelf.test",
  "password": "ChangeMe123!"
}

### Admin refresh token
POST {{admin}}/refresh-token

### Admin logout
POST {{admin}}/logout

### Admin me
GET {{admin}}/me

### Admin - list pending shops
GET {{admin}}/shops?status=pending&page=1&limit=20

### Admin - list all shops
GET {{admin}}/shops?status=all

### Admin - approve a shop
PATCH {{admin}}/shops/REPLACE_WITH_SHOP_ID/approve

### Admin - reject a shop
PATCH {{admin}}/shops/REPLACE_WITH_SHOP_ID/reject
Content-Type: application/json

{
  "reason": "Address could not be verified"
}