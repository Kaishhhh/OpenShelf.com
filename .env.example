DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/OpenShelf?retryWrites=true&w=majority"
REDIS_URL="rediss://<user>:<password>@<host>:<port>"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
USER_UI_URL="http://localhost:3000"
SELLER_UI_URL="http://localhost:3001"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ImageKit — the browser uploads directly using signed params from
# GET /product/upload-auth. IMAGEKIT_PRIVATE_KEY signs those params and
# authenticates management calls; it must never reach a client.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Transactional email. RESEND_API_KEY authenticates the send; EMAIL_FROM must be
# a verified sender. onboarding@resend.dev needs no DNS setup but only delivers to
# the address on your own Resend account.
RESEND_API_KEY=
EMAIL_FROM="OpenShelf <onboarding@resend.dev>"

# Stripe Connect (Accounts v2, recipient) — test mode only in development:
# STRIPE_SECRET_KEY must be an sk_test_ key. STRIPE_WEBHOOK_SECRET verifies the
# thin event notifications sent to POST /seller/stripe/webhook. In staging and
# production it is the signing secret of a v2 event destination (thin payload,
# v2.core.account[...] events) pointing at the gateway's public URL.
# Locally, `stripe listen --print-secret` gives a secret, but as of Stripe CLI
# 1.50.11 `stripe listen --thin-events` did not forward v2 account events
# (checked 2026-09-15). Until a destination exists, the dashboard's
# GET /seller/stripe/status read re-syncs the Seller row from Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Verifies v1 payment_intent.* events sent to POST /order/webhook — a separate
# event destination (snapshot payloads) from the account events above, with its
# own signing secret. Locally: `stripe listen --print-secret`, then forward with
# `stripe listen --forward-to localhost:8080/order/webhook`.
STRIPE_PAYMENTS_WEBHOOK_SECRET=

# Kafka — the event backbone (order-service produces, notification-service
# consumes). Confluent Cloud Basic in development: KAFKA_BROKERS is the cluster's
# bootstrap server (host:port, comma-separated if several), KAFKA_USERNAME and
# KAFKA_PASSWORD are a Kafka API key and its secret, and the mechanism is PLAIN
# over TLS. scram-sha-256 / scram-sha-512 are also accepted for other brokers.
# Leave KAFKA_USERNAME unset for a local unauthenticated broker (plaintext).
# Topics are not auto-created by producers: order.created, order.status-changed,
# notification-service.retry and notification-service.dlq must exist
# (notification-service creates any that are missing if the key is allowed to).
# Producing never fails a request — with the broker unreachable, checkout still
# succeeds and the event is logged as lost.
KAFKA_BROKERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=plain
# Optional: set to false to run a notification-service replica that serves HTTP
# and sockets but consumes no Kafka events (the Redis adapter delivers its emits).
# KAFKA_CONSUMERS_ENABLED=
# Optional: notification-service retry backoff, comma-separated milliseconds
# (default 5000,30000,120000). Only useful for demonstrating the retry path.
# KAFKA_RETRY_BACKOFF_MS=

# Optional — each falls back to the localhost default shown if unset.
# Only the gateway reads *_SERVICE_URL; every service reads its own PORT.
# Set these explicitly once anything runs off localhost (staging, prod).
# AUTH_SERVICE_URL="http://localhost:6001"
# SELLER_SERVICE_URL="http://localhost:6003"
# ADMIN_SERVICE_URL="http://localhost:6007"
# ORDER_SERVICE_URL="http://localhost:6004"
# NOTIFICATION_SERVICE_URL="http://localhost:6005"
PRODUCT_SERVICE_URL="http://localhost:6002"
# PORT=8080

# Firebase Cloud Messaging — push to recipients with no open tab. The service
# account JSON (Firebase console → Project settings → Service accounts → Generate
# new private key), base64-encoded onto one line, e.g.
#   base64 -w0 service-account.json      (macOS: base64 -i service-account.json)
# Never commit the JSON file itself. notification-service boots without it; only
# pushes fail, loudly.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# The UIs read these from their own apps/<ui>/.env, not this file (all public by
# design — they identify the Firebase project to the browser SDK):
#   NEXT_PUBLIC_FIREBASE_API_KEY, NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN,
#   NEXT_PUBLIC_FIREBASE_PROJECT_ID, NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID,
#   NEXT_PUBLIC_FIREBASE_APP_ID, NEXT_PUBLIC_FIREBASE_VAPID_KEY (Cloud Messaging →
#   Web Push certificates).
# Optional, defaulting to the gateway on localhost:
#   NEXT_PUBLIC_NOTIFICATION_API_URL=http://localhost:8080/notification
#   NEXT_PUBLIC_SOCKET_URL=http://localhost:8080
#   NEXT_PUBLIC_SOCKET_PATH=/notification/socket.io
