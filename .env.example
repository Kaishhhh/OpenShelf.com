DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/OpenShelf?retryWrites=true&w=majority"
REDIS_URL="rediss://<user>:<password>@<host>:<port>"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
USER_UI_URL="http://localhost:3000"
SELLER_UI_URL="http://localhost:3001"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ImageKit — the browser uploads directly using signed params from
# GET /product/upload-auth. IMAGEKIT_PRIVATE_KEY signs those params and
# authenticates management calls; it must never reach a client.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Transactional email. RESEND_API_KEY authenticates the send; EMAIL_FROM must be
# a verified sender. onboarding@resend.dev needs no DNS setup but only delivers to
# the address on your own Resend account.
RESEND_API_KEY=
EMAIL_FROM="OpenShelf <onboarding@resend.dev>"

# Optional — each falls back to the localhost default shown if unset.
# Only the gateway reads *_SERVICE_URL; every service reads its own PORT.
# Set these explicitly once anything runs off localhost (staging, prod).
# AUTH_SERVICE_URL="http://localhost:6001"
# SELLER_SERVICE_URL="http://localhost:6003"
# ADMIN_SERVICE_URL="http://localhost:6007"
# ORDER_SERVICE_URL="http://localhost:6004"
PRODUCT_SERVICE_URL="http://localhost:6002"
# PORT=8080
